{
  "name": "@smartbear/browser-info",
  "version": "2.1.0",
  "description": "Tiny developer-friendly JS library that provides information about host browser",
  "main": "dist/smartbear-browser-info.cjs",
  "module": "dist/smartbear-browser-info.esm.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/smartbear-browser-info.esm.js",
      "require": "./dist/smartbear-browser-info.cjs"
    },
    "./embed": {
      "import": "./dist/smartbear-browser-info.embed.esm.js",
      "require": "./dist/smartbear-browser-info.embed.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx rollup -c",
    "lint": "npx eslint .",
    "test": "npx mocha",
    "coverage": "c8 --all --include='src/**/*.js' --reporter=text --reporter=lcov mocha",
    "test:package": "mocha test-package/*.js",
    "prepack": "npm run build && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmartBear/browser-info.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "smartbear",
    "browser",
    "info",
    "browserinfo",
    "navigator",
    "detect",
    "useragent"
  ],
  "author": "Marek Sierociński <marek.sierocinski@smartbear.com>",
  "contributors": [
    {
      "name": "Piotr Sapiejewski",
      "email": "piotr.sapiejewski@smartbear.com"
    },
    {
      "name": "Marietta Suchanek",
      "email": "marietta.suchanek@smartbear.com"
    }
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SmartBear/browser-info/issues"
  },
  "homepage": "https://github.com/SmartBear/browser-info#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "rollup": "^4.67.5",
    "rollup-plugin-delete": "^3.0.2"
  }
}
